# ── LLM ──────────────────────────────────────────────────────────────────
# Set ONE credential below and you are done — the provider is auto-detected.
# Everything else (which model, temperature, per-node overrides) is
# configured in portfolio_agent/llm.py, and every default there can be
# overridden by an env var here.
#
# To see exactly what will be called, and why:
#     uv run python -m portfolio_agent.llm_doctor
#     uv run python -m portfolio_agent.llm_doctor --ping   # one real call per node

# Credentials. The first one set, in the order mistral → anthropic → openai
# → google → groq → bedrock, wins. Reorder AUTO_DETECT_ORDER in llm.py, or
# override outright with PORTFOLIO_AGENT_LLM_PROVIDER below.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# AWS's own env var name for a Bedrock API key — botocore reads it directly,
# so no AWS_ACCESS_KEY_ID/SECRET is needed.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1

# Force a provider and/or model for every node, ignoring auto-detection.
# Provider values are the keys of PROVIDERS in llm.py: mistral, anthropic,
# openai, google, groq, bedrock, ollama.
# PORTFOLIO_AGENT_LLM_PROVIDER=mistral
# PORTFOLIO_AGENT_LLM_MODEL=mistral-large-latest

# Generation settings for every node.
# PORTFOLIO_AGENT_LLM_TEMPERATURE=0
# PORTFOLIO_AGENT_LLM_MAX_TOKENS=1024
# PORTFOLIO_AGENT_LLM_TIMEOUT_S=60
# PORTFOLIO_AGENT_LLM_MAX_RETRIES=2

# Per-profile overrides beat both of the above. Profiles are RATIONALE (the
# valuation narrative) and MANAGER (the instruction parser); the pattern is
# PORTFOLIO_AGENT_LLM_<PROFILE>_<SETTING>. Use these to put the narrative on
# a strong model and the structured parser on a cheap fast one.
# PORTFOLIO_AGENT_LLM_RATIONALE_PROVIDER=anthropic
# PORTFOLIO_AGENT_LLM_RATIONALE_MODEL=claude-sonnet-5
# PORTFOLIO_AGENT_LLM_RATIONALE_TEMPERATURE=0.2
# PORTFOLIO_AGENT_LLM_MANAGER_PROVIDER=mistral
# PORTFOLIO_AGENT_LLM_MANAGER_MODEL=mistral-small-latest

# ── Namebio comps API ────────────────────────────────────────────────────
# The only external vendor confirmed available for Phase 1. If left blank,
# the namebio tool runs in mock mode (clearly labeled in its output) instead
# of failing, so the graph is still runnable end to end without the key.
NAMEBIO_API_KEY=
NAMEBIO_BASE_URL=https://namebio.com/api

# ── Search (portfolio_agent/tools/search.py) ───────────────────────────────
# Tried in order: SearXNG (free, self-hosted) first, then Tavily/Exa if it
# errors or comes back empty. All three unset just means the search tool
# reports itself unavailable, same as any other missing key here.
#
# The docker-compose.yml in this repo runs a SearXNG container alongside the
# app, reachable at the container hostname below — no key needed. Point this
# at a different instance, or leave the default, when running via compose.
SEARXNG_BASE_URL=http://searxng:8080
# Paid fallbacks. Tavily: https://tavily.com (1,000 free searches/month).
# Exa: https://exa.ai (~1,400 searches per $10) — used for domain resolution,
# where a neural similarity search outperforms a keyword one.
TAVILY_API_KEY=
EXA_API_KEY=

# ── Internal Namekart data services (valuation tools) ─────────────────────
# No API keys — these are our own services. Defaults point at production;
# override to test against another copy. config.py explains why the
# freshness bounds are set explicitly.
DVS_BASE_URL=https://dvs.vps4.auctionhacker.com
DVS_SYSTEM_ACTOR=portfolio-agent
DVS_ESTIBOT_MAX_AGE_DAYS=30
DVS_GDV_MAX_AGE_DAYS=180
NAMEBIO_SERVICE_BASE_URL=https://namebio.vps4.auctionhacker.com
COMPARABLE_AGENT_BASE_URL=https://comparable-agent.h.namekart.com

# ── Tool tier ────────────────────────────────────────────────────────────
# Phase 1 = read-only advisory tools only. Mutating tools (reprice/pause/
# drop) do not exist yet in this repo — this flag is here so a future tier
# fails closed instead of silently becoming available.
PORTFOLIO_AGENT_TIER=read_only

# ── Mock mode ────────────────────────────────────────────────────────────
# Answer every external tool from a deterministic fixture instead of calling
# the real service. Lets the full valuation graph run with no keys, no
# network and no vendor credits. Mock data is labeled as such in the output's
# evidence and warnings, so it can never be mistaken for a real appraisal.
PORTFOLIO_AGENT_MOCK_MODE=false

# ── HTTP hardening ───────────────────────────────────────────────────────
# Retries apply to timeouts, dropped connections, 429s and 5xx only.
PORTFOLIO_AGENT_HTTP_MAX_ATTEMPTS=3
PORTFOLIO_AGENT_HTTP_BACKOFF_BASE_S=0.25

# Combine fixture data with a REAL model — for iterating on prompts. Without
# it, mock mode returns no model at all, so an offline run never bills a live
# endpoint. See portfolio_agent/llm.py.
PORTFOLIO_AGENT_MOCK_ALLOW_LLM=false

# ── Logging ──────────────────────────────────────────────────────────────
# Structured logs for every step of a valuation. Only the `portfolio_agent`
# logger is configured — importing this package never changes how a host
# application logs. See portfolio_agent/logging_setup.py.
PORTFOLIO_AGENT_LOG_LEVEL=INFO
# text (human, one line per event) or json (one object per line, for an
# aggregator). A log FILE is always JSON regardless of this setting.
PORTFOLIO_AGENT_LOG_FORMAT=text
# Also append JSON records to this path.
# PORTFOLIO_AGENT_LOG_FILE=./portfolio-agent.log
# Set to "off" to stop this package configuring logging at all, when the host
# application configures it instead.
# PORTFOLIO_AGENT_LOG_SETUP=off

# ── Marketplace listings (APVA Table 4.1.1, List Price BIN) ──────────────
# Live ASKING prices. A listing is what a seller wants; a comp is what a
# buyer paid. They are kept in separate inputs and only the BIN tier — which
# is itself an ask — reads a listing. Each marketplace controls its own API,
# so any subset of these may be configured.

# Name.ai's own marketplace. Availability is public; listing PRICES need a
# token with the pricing:read scope.
NAMEAI_API_BASE_URL=https://api.name.ai
NAMEAI_API_TOKEN=

# GoDaddy Auctions aftermarket listings.
GODADDY_API_BASE_URL=https://api.godaddy.com
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_CUSTOMER_ID=MY

# How far a live ask may pull the BIN tier (0 = ignore listings entirely,
# 1 = adopt the ask outright). Capped well below 1 on purpose.
PORTFOLIO_AGENT_LISTING_BIN_PULL=0.35

# Dynadot — a second marketplace AND a second appraisal source. Genuinely
# different inventory from GoDaddy's: consulting.ai is listed on GoDaddy at
# ~$2.8M and absent from Dynadot's 5.9M listings entirely, while Dynadot
# will still appraise it. No single provider covers the aftermarket.
# Endpoint paths are overridable because they are NOT yet verified against
# the live API.
DYNADOT_API_KEY=
DYNADOT_BASE_URL=https://api.dynadot.com/restful/v1
# DYNADOT_LISTING_PATH=/market/listings/{domain}
# DYNADOT_APPRAISAL_PATH=/domains/{domain}/appraisal

# ── Internal comps (our own brokerage book) ──────────────────────────────
# The most trustworthy comps available and the only ones nobody else has.
# Closed sales become comps (weighted above scraped records, below exact
# matches). Offers and inquiries do NOT — an offer is a price nobody paid —
# they feed a demand signal instead. Counterparty identity is stripped at
# the tool boundary and never reaches a prompt or a log.
INTERNAL_COMPS_URL=
INTERNAL_COMPS_TOKEN=
